{
  "info": {
    "name": "RamDhan - Cart Module",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://dev.ramdhan.in" },
    { "key": "token", "value": "YOUR_ADMIN_TOKEN" },
    { "key": "customer_token", "value": "YOUR_CUSTOMER_TOKEN" },
    { "key": "guest_token", "value": "YOUR_GUEST_TOKEN" },
    { "key": "cart_uuid", "value": "CART_UUID" },
    { "key": "cart_item_uuid", "value": "CART_ITEM_UUID" },
    { "key": "product_uuid", "value": "PRODUCT_UUID" },
    { "key": "variant_uuid", "value": "VARIANT_UUID" }
  ],
  "item": [
    {
      "name": "Admin Carts",
      "item": [
        {
          "name": "List Carts + Filters",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/carts?page=1&per_page=20&sort_by=grand_total&sort_order=desc&search=john&filters[customer_id]=1&filters[status]=active&filters[coupon_code]=WELCOME10&filters[min_total]=100&filters[max_total]=5000&filters[from_date]=2026-08-01&filters[to_date]=2026-08-31",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "carts"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "per_page", "value": "20" },
                { "key": "sort_by", "value": "grand_total" },
                { "key": "sort_order", "value": "desc" },
                { "key": "search", "value": "john" },
                { "key": "filters[customer_id]", "value": "1" },
                { "key": "filters[status]", "value": "active" },
                { "key": "filters[coupon_code]", "value": "WELCOME10" },
                { "key": "filters[min_total]", "value": "100" },
                { "key": "filters[max_total]", "value": "5000" },
                { "key": "filters[from_date]", "value": "2026-08-01" },
                { "key": "filters[to_date]", "value": "2026-08-31" }
              ]
            }
          }
        },
        {
          "name": "Show Cart",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/carts/{{cart_uuid}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "carts", "{{cart_uuid}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Storefront Cart",
      "item": [
        {
          "name": "Get / Create Cart",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customer_token}}" },
              { "key": "X-Guest-Token", "value": "{{guest_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/cart",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "cart"]
            }
          }
        },
        {
          "name": "Add Item",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Guest-Token", "value": "{{guest_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_uuid\": \"{{product_uuid}}\",\n  \"variant_uuid\": \"{{variant_uuid}}\",\n  \"quantity\": 2\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/cart/items",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "cart", "items"]
            }
          }
        },
        {
          "name": "Update Item Quantity",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Guest-Token", "value": "{{guest_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 3\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/cart/items/{{cart_item_uuid}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "cart", "items", "{{cart_item_uuid}}"]
            }
          }
        },
        {
          "name": "Remove Item",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "X-Guest-Token", "value": "{{guest_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/cart/items/{{cart_item_uuid}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "cart", "items", "{{cart_item_uuid}}"]
            }
          }
        },
        {
          "name": "Merge Guest Cart (authenticated)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customer_token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Guest-Token", "value": "{{guest_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/cart/merge",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "cart", "merge"]
            }
          }
        }
      ]
    }
  ]
}