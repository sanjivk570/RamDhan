            "url": {
              "raw": "{{base_url}}/api/v1/purchase-orders?page=1&per_page=20&sort_by=created_at&sort_order=desc&search=PO&filters[supplier]=1&filters[status]=approved&filters[from_date]=2026-08-01&filters[to_date]=2026-08-31",
