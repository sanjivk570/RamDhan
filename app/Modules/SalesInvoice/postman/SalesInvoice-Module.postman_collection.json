{
  "info": {
    "name": "RamDhan - SalesInvoice Module",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://dev.ramdhan.in" },
    { "key": "token", "value": "YOUR_ADMIN_TOKEN" },
    { "key": "customer_token", "value": "YOUR_CUSTOMER_TOKEN" },
    { "key": "invoice_uuid", "value": "INVOICE_UUID" },
    { "key": "order_uuid", "value": "ORDER_UUID" }
  ],
  "item": [
    {
      "name": "Admin Invoices",
      "item": [
        {
          "name": "List Invoices + Filters",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/invoices?page=1&per_page=20&sort_by=invoice_date&sort_order=desc&search=INV-&filters[status]=paid&filters[customer_id]=1&filters[due_only]=true&filters[min_total]=500&filters[max_total]=50000&filters[from_date]=2026-08-01&filters[to_date]=2026-08-31",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "invoices"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "per_page", "value": "20" },
                { "key": "sort_by", "value": "invoice_date" },
                { "key": "sort_order", "value": "desc" },
                { "key": "search", "value": "INV-" },
                { "key": "filters[status]", "value": "paid" },
                { "key": "filters[customer_id]", "value": "1" },
                { "key": "filters[due_only]", "value": "true" },
                { "key": "filters[min_total]", "value": "500" },
                { "key": "filters[max_total]", "value": "50000" },
                { "key": "filters[from_date]", "value": "2026-08-01" },
                { "key": "filters[to_date]", "value": "2026-08-31" }
              ]
            }
          }
        },
        {
          "name": "Show Invoice",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/invoices/{{invoice_uuid}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "invoices", "{{invoice_uuid}}"]
            }
          }
        },
        {
          "name": "Generate Invoice For Order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/invoices/orders/{{order_uuid}}/generate",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "invoices", "orders", "{{order_uuid}}", "generate"]
            }
          }
        }
      ]
    },
    {
      "name": "Customer Invoices",
      "item": [
        {
          "name": "My Invoices",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customer_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/invoices",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "invoices"]
            }
          }
        },
        {
          "name": "Show Invoice",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customer_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/invoices/{{invoice_uuid}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "invoices", "{{invoice_uuid}}"]
            }
          }
        }
      ]
    }
  ]
}