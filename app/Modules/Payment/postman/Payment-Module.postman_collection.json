{
  "info": {
    "name": "RamDhan - Payment Module",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://dev.ramdhan.in" },
    { "key": "token", "value": "YOUR_ADMIN_TOKEN" },
    { "key": "customer_token", "value": "YOUR_CUSTOMER_TOKEN" },
    { "key": "guest_token", "value": "YOUR_GUEST_TOKEN" },
    { "key": "order_uuid", "value": "ORDER_UUID" },
    { "key": "intent_uuid", "value": "PAYMENT_INTENT_UUID" },
    { "key": "webhook_signature", "value": "YOUR_WEBHOOK_SIGNATURE" }
  ],
  "item": [
    {
      "name": "Admin Payments",
      "item": [
        {
          "name": "List Payment Transactions + Filters",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/payments/transactions?page=1&per_page=20&sort_by=created_at&sort_order=desc&search=txn_123&filters[status]=success&filters[provider]=razorpay&filters[transaction_type]=payment&filters[order_id]=1&filters[min_amount]=100&filters[max_amount]=50000&filters[from_date]=2026-08-01&filters[to_date]=2026-08-31",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "payments", "transactions"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "per_page", "value": "20" },
                { "key": "sort_by", "value": "created_at" },
                { "key": "sort_order", "value": "desc" },
                { "key": "search", "value": "txn_123" },
                { "key": "filters[status]", "value": "success" },
                { "key": "filters[provider]", "value": "razorpay" },
                { "key": "filters[transaction_type]", "value": "payment" },
                { "key": "filters[order_id]", "value": "1" },
                { "key": "filters[min_amount]", "value": "100" },
                { "key": "filters[max_amount]", "value": "50000" },
                { "key": "filters[from_date]", "value": "2026-08-01" },
                { "key": "filters[to_date]", "value": "2026-08-31" }
              ]
            }
          }
        },
        {
          "name": "Refund Order Payment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 1500,\n  \"reason\": \"Customer requested refund\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/admin/payments/orders/{{order_uuid}}/refund",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "payments", "orders", "{{order_uuid}}", "refund"]
            }
          }
        }
      ]
    },
    {
      "name": "Frontend Payments",
      "item": [
        {
          "name": "Create Payment Intent",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Guest-Token", "value": "{{guest_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"order_uuid\": \"{{order_uuid}}\",\n  \"provider\": \"razorpay\",\n  \"method\": \"upi\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/payments/intent",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "payments", "intent"]
            }
          }
        },
        {
          "name": "Show Payment Intent",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "X-Guest-Token", "value": "{{guest_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/payments/intents/{{intent_uuid}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "payments", "intents", "{{intent_uuid}}"]
            }
          }
        },
        {
          "name": "Payment Webhook",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Webhook-Signature", "value": "{{webhook_signature}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider\": \"razorpay\",\n  \"event\": \"payment.captured\",\n  \"payload\": {\n    \"order_uuid\": \"{{order_uuid}}\",\n    \"transaction_id\": \"pay_123456\",\n    \"status\": \"success\",\n    \"amount\": 5000,\n    \"method\": \"upi\",\n    \"reference\": \"REF-001\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/payments/webhook",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "payments", "webhook"]
            }
          }
        }
      ]
    }
  ]
}