{
  "info": {
    "_postman_id": "cart-checkout-collection",
    "name": "Cart + Checkout",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "{{base_url}}" },
    { "key": "auth_token", "value": "" },
    { "key": "guest_token", "value": "" }
  ],
  "item": [
    {
      "name": "Cart",
      "item": [
        {
          "name": "Get Cart",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" },
              { "key": "X-Guest-Token", "value": "{{guest_token}}" }
            ],
            "url": { "raw": "{{base_url}}/api/v1/cart", "host": ["{{base_url}}"], "path": ["api","v1","cart"] }
          }
        },
        {
          "name": "Add Cart Item",
          "request": {
            "method": "POST",
            "header": [ { "key": "Accept", "value": "application/json" }, { "key": "X-Guest-Token", "value": "{{guest_token}}" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_uuid\": \"<product-uuid>\",\n  \"variant_uuid\": null,\n  \"quantity\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/v1/cart/items", "host": ["{{base_url}}"], "path": ["api","v1","cart","items"] }
          }
        },
        {
          "name": "Update Cart Item",
          "request": {
            "method": "PUT",
            "header": [ { "key": "Accept", "value": "application/json" }, { "key": "X-Guest-Token", "value": "{{guest_token}}" } ],
            "body": { "mode": "raw", "raw": "{ \"quantity\": 2 }", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{base_url}}/api/v1/cart/items/:uuid", "host": ["{{base_url}}"], "path": ["api","v1","cart","items",":uuid"] }
          }
        },
        {
          "name": "Remove Cart Item",
          "request": {
            "method": "DELETE",
            "header": [ { "key": "Accept", "value": "application/json" }, { "key": "X-Guest-Token", "value": "{{guest_token}}" } ],
            "url": { "raw": "{{base_url}}/api/v1/cart/items/:uuid", "host": ["{{base_url}}"], "path": ["api","v1","cart","items",":uuid"] }
          }
        },
        {
          "name": "Merge Guest Cart to Customer",
          "request": {
            "method": "POST",
            "header": [ { "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{auth_token}}" }, { "key": "X-Guest-Token", "value": "{{guest_token}}" } ],
            "url": { "raw": "{{base_url}}/api/v1/cart/merge", "host": ["{{base_url}}"], "path": ["api","v1","cart","merge"] }
          }
        }
      ]
    },
    {
      "name": "Checkout",
      "item": [
        {
          "name": "Checkout Preview",
          "request": {
            "method": "POST",
            "header": [ { "key": "Accept", "value": "application/json" }, { "key": "X-Guest-Token", "value": "{{guest_token}}" } ],
            "body": { "mode": "raw", "raw": "{}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{base_url}}/api/v1/orders/checkout/preview", "host": ["{{base_url}}"], "path": ["api","v1","orders","checkout","preview"] }
          }
        },
        {
          "name": "Checkout (Create Order)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Accept", "value": "application/json" }, { "key": "X-Guest-Token", "value": "{{guest_token}}" }, { "key": "Authorization", "value": "Bearer {{auth_token}}" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"guest_token\": \"{{guest_token}}\",\n  \"email\": \"buyer@example.com\",\n  \"first_name\": \"John\",\n  \"last_name\": \"Doe\",\n  \"payment_method\": \"cod\",\n  \"shipping_address\": {\n    \"street\": \"123 Main St\",\n    \"city\": \"City\",\n    \"state\": \"State\",\n    \"postal_code\": \"12345\",\n    \"country\": \"IN\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/v1/orders/checkout", "host": ["{{base_url}}"], "path": ["api","v1","orders","checkout"] }
          }
        },
        {
          "name": "Guest Order Lookup",
          "request": {
            "method": "GET",
            "header": [ { "key": "Accept", "value": "application/json" }, { "key": "X-Guest-Token", "value": "{{guest_token}}" } ],
            "url": { "raw": "{{base_url}}/api/v1/guest/orders/:orderNumber", "host": ["{{base_url}}"], "path": ["api","v1","guest","orders",":orderNumber"] }
          }
        }
      ]
    }
  ]
}
